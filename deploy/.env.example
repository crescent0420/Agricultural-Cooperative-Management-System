# Production settings for deploy/compose.yaml. Copy to deploy/.env and fill in:   Copy-Item .env.example .env
# deploy/.env is git-ignored and never copied into an image. Keep it different from the development ..\.env.

# ---- Address ----
# localhost = this laptop only (HTTPS with Caddy's local certificate). A domain name (e.g. acms.example.rw)
# makes Caddy fetch a public certificate; the name must point to this machine and ports 80/443 must be open.
SITE_ADDRESS=localhost

# ---- Database (created on the first start of the db container) ----
DB_NAME=acms_prod
DB_USERNAME=acms_prod
DB_PASSWORD=change-me-generate-a-random-value-see-docs-deployment

# ---- Login tokens ----
# At least 32 characters, random, and different from development.
ACMS_JWT_SECRET=change-me-generate-a-random-value-of-at-least-32-chars
ACMS_JWT_ISSUER=acms-api
ACMS_JWT_TTL_MINUTES=30

# ---- Email: a real SMTP account (Gmail shown; needs 2-Step Verification and an app password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your16letterapppassword
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=ACMS <your.address@gmail.com>

# ---- Demo data: never in production ----
APP_DEMO_SEED=false
