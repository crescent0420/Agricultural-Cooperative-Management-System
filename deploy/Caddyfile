# Caddy for ACMS (docs/deployment.md). One address serves both the React app and the API, so the browser never
# makes a cross-origin request and the backend needs no CORS settings (URD gap G1).
#
# SITE_ADDRESS comes from deploy/.env. "localhost" gets a certificate from Caddy's own local certificate
# authority (trust it once, see the guide); a real domain name gets a free public certificate automatically.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# The API: everything under /api goes to the Spring Boot container.
	handle /api/* {
		reverse_proxy app:8081
	}

	# The React app: real files as they are, every other path gets index.html (the router takes over).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Built files have a content hash in their name, so browsers may keep them; index.html is always rechecked.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"
}
