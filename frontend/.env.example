# Copy to .env.local (git-ignored) only if you need to change something.
#
# Origin of the Spring Boot API, WITHOUT /api at the end.
# Leave EMPTY in development: the Vite dev server forwards /api to http://localhost:8081.
# Set it when building for production, e.g. VITE_API_BASE_URL=https://api.example.org
VITE_API_BASE_URL=
