  },
  "item": [
    {
      "name": "F00a Login as Union Registrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registrarUsername}}\",\n  \"password\": \"{{registrarPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"login succeeded (200)\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "    const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
              "    store.set(\"registrarToken\", pm.response.json().accessToken);",
              "}"
            ]
          }
        }
      ]
    },
