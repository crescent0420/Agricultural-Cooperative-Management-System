    {
      "name": "I10 Registrar: farmers per cooperative (whole Union)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reports/farmers-per-cooperative",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "farmers-per-cooperative"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{registrarToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"report (200)\", () => pm.response.to.have.status(200));",
              "pm.test(\"report envelope: basis, scope, rows, totals\", () => {",
              "    const d = (pm.response.json().data || pm.response.json());",
              "    pm.expect(d.basis).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(d.rows).to.be.an(\"array\");",
              "    pm.expect(d.totals).to.be.an(\"object\");",
              "});",
              "pm.test(\"totals.total = the sum of the rows\", () => {",
              "    const d = (pm.response.json().data || pm.response.json());",
              "    pm.expect(d.totals.total).to.eql(d.rows.reduce((s, r) => s + r.total, 0));",
              "    pm.expect(d.totals.cooperatives).to.eql(d.rows.length);",
              "});",
              "pm.test(\"each row: the statuses add up to the total\", () => {",
              "    const d = (pm.response.json().data || pm.response.json());",
              "    d.rows.forEach(r => pm.expect(r.active + r.suspended + r.withdrawn + r.retired).to.eql(r.total));",
              "});"
            ]
          }
        }
      ]
    },
    {
