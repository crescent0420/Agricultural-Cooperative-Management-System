    {
      "name": "I01 Setup: season (its own, so the numbers below are known)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/seasons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "seasons"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{registrarToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Report season {{iStamp}}\",\n  \"startsOn\": \"{{today}}\",\n  \"endsOn\": \"{{in90days}}\",\n  \"maxLandHectares\": 2.5,\n  \"distributionDate\": \"{{in30days}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = n => { const x = new Date(); x.setDate(x.getDate() + n); return x.toISOString().slice(0, 10); };",
              "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
              "store.set(\"today\", d(0)); store.set(\"in30days\", d(30)); store.set(\"in90days\", d(90)); store.set(\"iStamp\", Date.now());",
              "// any district that is not yours, for the 403 checks",
              "store.set(\"otherDistrictId\", Number(pm.variables.get(\"ownDistrictId\")) === 1 ? 2 : 1);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
              "    store.set(\"iSeasonId\", (pm.response.json().data || pm.response.json()).id);",
              "}"
            ]
          }
        }
      ]
    },
