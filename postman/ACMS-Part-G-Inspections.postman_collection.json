{
  "info": {
    "_postman_id": "c6214e7e-8dd1-4396-a822-de010ee0c620",
    "name": "ACMS - Part G Inspections and results",
    "description": "Run in order with the ACMS-Local environment. Needs: the Field Officer (officerUserId) and a District Agronomist (agronomistUsername; agronomistPassword in the environment) of ownDistrictId, the farmer (ownFarmerId, in ownDistrictId), otherFarmerId = any other farmer, and the Finance Officer from Part F. Each run creates its own season, programme and offering, so it can be run again. Every answer is {success, message, data | error, timestamp}: the tests read data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "G00a Login as Union Registrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registrarUsername}}\",\n  \"password\": \"{{registrarPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"login succeeded (200)\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "    const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
              "    store.set(\"registrarToken\", (pm.response.json().data || pm.response.json()).accessToken);",
              "}"
            ]
          }
        }
      ]
    },
