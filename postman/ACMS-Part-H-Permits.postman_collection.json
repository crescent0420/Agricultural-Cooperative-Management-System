{
  "info": {
    "_postman_id": "b0bbfd4f-4d18-474a-850c-f5b0961e4827",
    "name": "ACMS - Part H Collection permits",
    "description": "Run in order with the ACMS-Local environment. Needs the registrar, Finance Officer and farmer accounts (ownFarmerId, in ownDistrictId) and officerUserId. Each run creates its own season, so it can be run again. Every answer is {success, message, data | error, timestamp}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "H00a Login as Union Registrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registrarUsername}}\",\n  \"password\": \"{{registrarPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"login succeeded (200)\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "    const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
              "    store.set(\"registrarToken\", (pm.response.json().data || pm.response.json()).accessToken);",
              "}",
              "pm.test(\"Union Registrar has replaced the one-time password\", () => pm.expect((pm.response.json().data || pm.response.json()).mustChangePassword, \"log in once with the emailed password and call POST /api/auth/change-password\").to.eql(false));"
            ]
          }
        }
      ]
    },
