# Copy this file to .env and fill in your own values:   Copy-Item .env.example .env
# .env is listed in .gitignore and must NEVER be committed.
# A real environment variable with the same name always wins over this file.

# ---- Application ----
SERVER_PORT=8081

# ---- Development database (required: the application will not start without these) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acms_db
DB_TEST_NAME=acms_test
DB_USERNAME=acms_user
DB_PASSWORD=change-me

# ---- Login tokens (required) ----
# At least 32 characters. Generate one with the PowerShell snippet in the README.
ACMS_JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-chars
ACMS_JWT_ISSUER=acms-api
ACMS_JWT_TTL_MINUTES=30

# ---- Email (optional) ----
# Leave these commented to use Mailpit on localhost:1025. Uncomment for Gmail (needs an app password).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=your16letterapppassword
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=ACMS <your.address@gmail.com>

# ---- Links inside emails (optional) ----
# Address of the web app: the verification link in emails opens its /verify-email page.
# APP_BASE_URL=http://localhost:5173

# ---- Demo data (optional): only fills an EMPTY system. See README section 6. ----
APP_DEMO_SEED=false
DEMO_SEED_PASSWORD=

# ---- Demo data (optional): only fills an EMPTY system. See README section 6. ----
APP_DEMO_SEED=false
DEMO_SEED_PASSWORD=
